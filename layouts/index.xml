{{- $pages := where .Site.RegularPages "Type" "post" -}}
{{- $limit := .Site.Params.rssLimit | default 25 -}}
<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
<channel>
<title>{{ .Site.Title }}</title>
<link>{{ .Site.BaseURL }}</link>
<description>{{ .Site.Params.description | plainify }}</description>
<generator>Hugo</generator>
<language>{{ .Site.LanguageCode | default "en" }}</language>
{{ with $pages }}<lastBuildDate>{{ (index . 0).Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</lastBuildDate>{{ end }}
<atom:link href="{{ "feed.xml" | absURL }}" rel="self" type="application/rss+xml" />
{{ range first $limit $pages }}
<item>
<title>{{ if .Title }}{{ .Title }}{{ else }}{{ .Date.Format "January 2, 2006" }}{{ end }}</title>
<link>{{ .Permalink }}</link>
<pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
<guid>{{ .Permalink }}</guid>
<description>{{ .Content | html }}</description>
</item>
{{ end }}
</channel>
</rss>